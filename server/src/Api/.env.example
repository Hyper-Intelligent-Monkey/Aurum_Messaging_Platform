ASPNETCORE_ENVIRONMENT=Development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5067

# PostgreSQL Database Credentials
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=messaging_platform;Username=postgres;Password=your_password

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# JWT Authentication Secrets
JwtSettings__Secret=your_super_secret_jwt_key_at_least_64_characters_long
JwtSettings__Issuer=MessagingServer
JwtSettings__Audience=MessagingClient
JwtSettings__ExpiryMinutes=120

# SMTP Email Configuration
EmailSettings__Host=smtp.gmail.com
EmailSettings__Port=587
EmailSettings__SenderEmail=your_email@gmail.com
EmailSettings__SenderName=Messaging Platform Name
EmailSettings__Password=your_app_password
EmailSettings__EnableSsl=true

