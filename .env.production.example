# Domain & URLs
DOMAIN_NAME=your-subdomain.duckdns.org
SERVER_URL=https://your-subdomain.duckdns.org
CLIENT_URL=https://your-app.vercel.app

# Database
DB_PASSWORD=choose_a_strong_database_password_here

# JWT Authentication (minimum 64 characters)
JwtSettings__Secret=your_super_secret_jwt_key_at_least_64_characters_long
JwtSettings__Issuer=MessagingServer
JwtSettings__Audience=MessagingClient
JwtSettings__ExpiryMinutes=120

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# SMTP Email Configuration (e.g. Gmail App Password)
EmailSettings__Host=smtp.gmail.com
EmailSettings__Port=587
EmailSettings__SenderEmail=your_email@gmail.com
EmailSettings__SenderName=Aurum Messaging
EmailSettings__Password=your_gmail_app_password
EmailSettings__EnableSsl=true

